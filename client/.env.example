# ---- API Inspector :: client configuration ----
# Copy to `.env` (or .env.local) and adjust. Vite only exposes VITE_* variables.

# Base URL of the API Inspector backend.
# Leave empty in development to use the Vite dev proxy (/api -> local server).
# Production example: https://api.inspector.example.com
VITE_API_BASE_URL=

# Port for the Vite dev server
VITE_PORT=5273

# Local backend the dev server proxies /api to
VITE_SERVER_URL=http://localhost:5274
