# ---- API Inspector :: server configuration ----
# Copy this file to `.env` and adjust. Never commit the real `.env`.

# Port the Express API listens on
PORT=5274

# Comma separated list of origins allowed to call this API.
# Development example: http://localhost:5273
# Production example:  https://inspector.example.com,https://www.inspector.example.com
CLIENT_URL=http://localhost:5273

# node env: development | production
NODE_ENV=development

# Abort outbound proxied requests after this many milliseconds (max 120000)
REQUEST_TIMEOUT=30000

# Maximum accepted response body size in bytes (default 10 MB)
MAX_RESPONSE_SIZE=10485760

# Maximum accepted request body size sent through the proxy
MAX_REQUEST_SIZE=2097152

# Maximum number of redirects the proxy will follow (each hop is re-validated)
MAX_REDIRECTS=5

# Rate limiting: window length and max proxied requests per client per window
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Set to "true" only for local development against private/localhost APIs.
# This disables the SSRF network guard and must stay false in production.
ALLOW_PRIVATE_NETWORK=false

# Serve the built client (client/dist) from the API process in production
SERVE_CLIENT=false
